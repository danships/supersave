{
  "name": "supersave",
  "version": "0.20.0",
  "description": "A package to create a simple datastore with a generic API for side projects.",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "watch": "tsc -w",
    "build": "tsc",
    "lint": "concurrently --kill-others-on-fail \"npm:lint:*\"",
    "lint:tsc": "tsc --noEmit",
    "lint:biome": "biome ci",
    "format": "biome check --write",
    "test": "vitest run",
    "test:all": "pnpm test && pnpm test:mysql && pnpm test:mariadb",
    "test:mysql": "cross-env CONN=mysql://supersave:savesuper@127.0.0.1:3306/supersave vitest run --no-file-parallelism",
    "test:mariadb": "cross-env CONN=mysql://supersave:savesuper@127.0.0.1:3307/supersave vitest run --no-file-parallelism",
    "test:watch": "cross-env DEBUG=supersave:* vitest",
    "test:watch:mysql": "cross-env DEBUG=supersave:* CONN=mysql://supersave:savesuper@127.0.0.1:3306/supersave vitest run --no-file-parallelism",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist",
    "start": "nodemon tests/run.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supersavehq/supersave.git"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11.22.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "sqlite",
    "database",
    "store",
    "api",
    "headless",
    "mysql",
    "supersave",
    "super"
  ],
  "author": "debuggingdan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danships/supersave/issues"
  },
  "homepage": "https://github.com/danships/supersave#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/better-sqlite3": "9.6.0",
    "@types/debug": "4.1.13",
    "@types/node": "26.2.0",
    "@types/pluralize": "0.0.33",
    "@types/slug": "5.0.9",
    "@types/supertest": "7.2.1",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "mysql2": "^3.23.4",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.1.2 || ^12.0.0",
    "mysql2": "^3.11.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "dependencies": {
    "better-call": "^1.4.0",
    "debug": "^4.4.3",
    "pluralize": "^8.0.0",
    "short-uuid": "^6.0.3",
    "slug": "^12.0.1",
    "zod": "^4.4.3"
  }
}
